{
  "manifest_version": 3,
  "name": "Orbit",
  "version": "0.1.0",
  "description": "A lightweight browser extension for capturing and organizing links, notes, and web content.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Orbit",
    "default_icon": {
      "16": "src/public/icons/icon-16.png",
      "32": "src/public/icons/icon-32.png",
      "48": "src/public/icons/icon-48.png",
      "128": "src/public/icons/icon-128.png"
    }
  }
}
